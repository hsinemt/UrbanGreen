# ========================================
# UrbanGreen Docker Environment Configuration
# For use with docker-compose.yml
# ========================================
# This file is pre-configured for Docker Compose
# Copy this to .env when running with Docker Compose

# ========================================
# Application Settings
# ========================================
APP_NAME=UrbanGreen
APP_ENV=production
# IMPORTANT: Generate a new key with: docker-compose exec app php artisan key:generate
# Or run: php artisan key:generate and paste the output here
APP_KEY=base64:REPLACE_WITH_YOUR_GENERATED_KEY
APP_DEBUG=false
APP_URL=http://localhost:8000

# Gemini API - Replace with your actual key
GEMINI_API_KEY=your-gemini-api-key-here

# Application locale settings
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Maintenance mode
APP_MAINTENANCE_DRIVER=file

# Password hashing
BCRYPT_ROUNDS=12

# ========================================
# Logging Configuration
# ========================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ========================================
# Database Configuration (Docker)
# ========================================
# Uses service names from docker-compose.yml
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=urbangreen_db
DB_USERNAME=laravel_user
# Set your database password (can be empty for local development)
DB_PASSWORD=
DB_ROOT_PASSWORD=root

# Database settings
DB_STRICT=false
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ========================================
# Session Configuration (Redis)
# ========================================
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# ========================================
# Cache & Queue Configuration (Redis)
# ========================================
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ========================================
# Redis Configuration (Docker)
# ========================================
# Uses service name from docker-compose.yml
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ========================================
# Mail Configuration
# ========================================
# For production, configure your actual mail service
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@urbangreen.com"
MAIL_FROM_NAME="${APP_NAME}"

# ========================================
# AWS Configuration (if using S3)
# ========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ========================================
# Twilio Configuration
# ========================================
# Replace with your actual Twilio credentials
TWILIO_SID=your-twilio-account-sid
TWILIO_TOKEN=your-twilio-auth-token
TWILIO_FROM=+1234567890

# ========================================
# OpenAI Configuration
# ========================================
# Replace with your actual OpenAI API key
OPENAI_API_KEY=your-openai-api-key

# ========================================
# Stripe Configuration
# ========================================
# Replace with your actual Stripe credentials
STRIPE_SECRET=sk_test_your-stripe-secret-key
STRIPE_PUBLIC=pk_test_your-stripe-public-key

# ========================================
# Brevo Configuration
# ========================================
# Replace with your actual Brevo API key
BREVO_API_KEY=your-brevo-api-key

# ========================================
# Vite Configuration
# ========================================
VITE_APP_NAME="${APP_NAME}"

# ========================================
# SSL Verification
# ========================================
# Set to false for local Docker development
SSL_VERIFY=false

# ========================================
# MySQL Configuration for Docker
# ========================================
# These are used by the mysql service in docker-compose.yml
MYSQL_ALLOW_EMPTY_PASSWORD=no

# ========================================
# Docker-Specific Settings
# ========================================
# These settings optimize Laravel for Docker environment

# Disable certain features that may not work well in containers
DEBUGBAR_ENABLED=false

# Optimize for production
OPTIMIZE_ROUTES=true
OPTIMIZE_CONFIG=true
OPTIMIZE_VIEWS=true

# ========================================
# INSTRUCTIONS
# ========================================
# 1. Copy this file to .env:
#    cp .env.docker .env
#
# 2. Generate application key:
#    docker-compose exec app php artisan key:generate
#
# 3. Replace placeholder API keys with your actual credentials:
#    - GEMINI_API_KEY
#    - TWILIO_SID, TWILIO_TOKEN, TWILIO_FROM
#    - OPENAI_API_KEY
#    - STRIPE_SECRET, STRIPE_PUBLIC
#    - BREVO_API_KEY
#
# 4. Set DB_PASSWORD if you want to secure your database
#
# 5. Build and start containers:
#    docker-compose up -d --build
#
# 6. Run migrations:
#    docker-compose exec app php artisan migrate --force
#
# 7. Access the application:
#    http://localhost:8000
