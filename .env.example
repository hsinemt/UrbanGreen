# ========================================
# UrbanGreen Application Configuration
# Environment Variables Template
# ========================================
# Copy this file to .env and fill in your actual values
# Never commit .env file with real secrets to version control

# ========================================
# Application Settings
# ========================================
APP_NAME=UrbanGreen
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Application locale and timezone settings
GEMINI_API_KEY=your-gemini-api-key-here
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Maintenance mode settings
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP CLI Server Workers (for development)
PHP_CLI_SERVER_WORKERS=4

# Password hashing rounds (higher = more secure but slower)
BCRYPT_ROUNDS=12

# ========================================
# Logging Configuration
# ========================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ========================================
# Database Configuration
# ========================================
# For production with Docker, use these settings:
# DB_CONNECTION=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=urbangreen_db
# DB_USERNAME=laravel_user
# DB_PASSWORD=your-secure-password

# For local development:
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=urbangreen_db
DB_USERNAME=root
DB_PASSWORD=

# Database additional settings
DB_STRICT=false
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ========================================
# Session Configuration
# ========================================
# For production with Redis (recommended):
# SESSION_DRIVER=redis
# SESSION_LIFETIME=120
# SESSION_ENCRYPT=false
# SESSION_PATH=/
# SESSION_DOMAIN=null

# For local development with file driver:
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# ========================================
# Cache & Queue Configuration
# ========================================
# For production (use Redis):
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis

# For local development:
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Broadcast driver (for WebSockets)
BROADCAST_CONNECTION=log

# Filesystem disk driver
FILESYSTEM_DISK=local

# Cache prefix (optional)
# CACHE_PREFIX=

# ========================================
# Redis Configuration
# ========================================
# For Docker environment:
# REDIS_CLIENT=phpredis
# REDIS_HOST=redis
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# For local development:
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ========================================
# Memcached Configuration (if using)
# ========================================
MEMCACHED_HOST=127.0.0.1

# ========================================
# Mail Configuration
# ========================================
# Using log driver for development
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# For production with SMTP:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=your-username
# MAIL_PASSWORD=your-password
# MAIL_FROM_ADDRESS="noreply@urbangreen.com"
# MAIL_FROM_NAME="${APP_NAME}"

# ========================================
# AWS Configuration (if using S3)
# ========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ========================================
# Twilio SMS/Voice Configuration
# ========================================
# Get credentials from: https://www.twilio.com/console
TWILIO_SID=your-twilio-account-sid
TWILIO_TOKEN=your-twilio-auth-token
TWILIO_FROM=+1234567890

# ========================================
# OpenAI API Configuration
# ========================================
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# ========================================
# Stripe Payment Configuration
# ========================================
# Get credentials from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET=sk_test_your-stripe-secret-key
STRIPE_PUBLIC=pk_test_your-stripe-public-key

# ========================================
# Brevo (Sendinblue) Email Marketing
# ========================================
# Get API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your-brevo-api-key

# ========================================
# Vite Frontend Configuration
# ========================================
VITE_APP_NAME="${APP_NAME}"

# ========================================
# SSL Certificate Verification
# ========================================
# Set to false only for local development
# ALWAYS set to true in production
SSL_VERIFY=false

# ========================================
# Additional Production Settings
# ========================================
# Uncomment and configure for production deployment

# Force HTTPS in production
# APP_FORCE_HTTPS=true

# Trusted proxies (for load balancers)
# TRUSTED_PROXIES=*

# Asset URL (for CDN)
# ASSET_URL=https://cdn.urbangreen.com

# Mix URL (for Webpack Mix assets)
# MIX_ASSET_URL=https://cdn.urbangreen.com
